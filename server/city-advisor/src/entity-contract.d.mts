export type EntityKind = 'house' | 'shop' | 'market' | 'factory' | 'farm' | 'household';
export type EntityUnit = 'satang' | 'satang/goods' | 'satang/crops' | 'people' | 'households' | 'goods' | 'crops' | 'positions' | 'boolean';
export type EntityPeriod = 'snapshot' | 'window' | 'today';
export type EntityMissingReason = 'unavailable' | 'not-modeled' | 'empty-period' | 'ambiguous' | 'unsafe' | 'non-integer';
export type EntityIdentity = { kind: EntityKind; id: number; buildingId: number | null; firmId: number | null; householdId: number | null; cell: number | null };
export type EntityWindow = { fromTick: number; toTick: number; inclusive: true; maxDays: 30; empty: boolean };
export type EntityFact = { id: string; value: number; unit: EntityUnit; period: EntityPeriod };
export type EntitySnapshot = { schemaVersion: 1; entity: EntityIdentity; tick: number; window: EntityWindow; facts: EntityFact[]; missing: { id: string; reason: EntityMissingReason }[]; snapshotKey: string };
export type EntityRequest = { schemaVersion: 2; operation: 'entity-explanation'; locale: 'th'; snapshot: EntitySnapshot };
export type EntityReportSelection = { observationIds: string[]; hypothesisIds: string[]; checkIds: string[] };
export type EntityResponse = { schemaVersion: 2; operation: 'entity-explanation'; mode: 'ai' | 'fallback'; snapshot: EntitySnapshot; report: EntityReportSelection };
export type EntityRow = { id: string; text: string; factRefs: string[] };
export type EntityRows = { observations: EntityRow[]; hypotheses: EntityRow[]; checks: EntityRow[] };
export const ENTITY_KIND_LABELS: Readonly<Record<EntityKind, string>>;
export const ENTITY_FACT_DEFINITIONS: Readonly<Record<string, { label: string; unit: EntityUnit; period: EntityPeriod; signed?: boolean }>>;
export function makeEntitySnapshot(value: Omit<EntitySnapshot, 'snapshotKey'>): EntitySnapshot;
export function validateEntitySnapshot(value: unknown): EntitySnapshot;
export function validateEntityRequest(value: unknown): EntityRequest;
export function entityExplanationCandidates(snapshot: EntitySnapshot): EntityRows;
export function validateEntitySelection(value: unknown, snapshot: EntitySnapshot): EntityReportSelection;
export function buildEntityReport(snapshot: EntitySnapshot, selection: unknown, mode?: 'ai' | 'fallback'): EntityResponse;
export function buildLocalEntityExplanation(snapshot: EntitySnapshot): EntityResponse;
export function acceptEntityExplanation(value: unknown, local: EntityResponse): EntityResponse | null;
export function entityExplanationRows(response: EntityResponse): EntityRows;
export function entityFactEvidence(snapshot: EntitySnapshot, id: string): string;
