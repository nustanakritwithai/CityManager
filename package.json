{
  "name": "citymanager",
  "private": true,
  "version": "0.4.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:submenus": "node tests/submenus-smoke.mjs",
    "assets:verify": "node scripts/admit-city-assets.mjs --verify && node scripts/admit-ui-assets.mjs --verify",
    "test:context": "node tests/context-smoke.mjs",
    "test:compact": "node tests/compact-smoke.mjs",
    "test:population": "node tests/population-smoke.mjs",
    "test:worker": "node tests/worker-smoke.mjs",
    "test:agriculture": "node tests/agriculture-smoke.mjs",
    "test:building-cards": "node tests/building-cards-smoke.mjs",
    "test:signals": "node --experimental-strip-types tests/signals-smoke.mjs",
    "test:advisor": "node --test server/city-advisor/test/*.test.mjs"
  },
  "dependencies": {
    "playcanvas": "2.23.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
