{
  "name": "citymanager",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:submenus": "node tests/submenus-smoke.mjs",
    "assets:verify": "node scripts/admit-city-assets.mjs --verify && node scripts/admit-ui-assets.mjs --verify && node scripts/admit-audio-assets.mjs --verify",
    "test:context": "node tests/context-smoke.mjs",
    "test:compact": "node tests/compact-smoke.mjs",
    "test:population": "node tests/population-smoke.mjs",
    "test:worker": "node tests/worker-smoke.mjs",
    "test:agriculture": "node tests/agriculture-smoke.mjs",
    "test:building-cards": "node tests/building-cards-smoke.mjs",
    "test:audio": "node --experimental-strip-types tests/audio-smoke.mjs",
    "test:signals": "node --experimental-strip-types tests/signals-smoke.mjs",
    "test:advisor": "node --experimental-strip-types --test server/city-advisor/test/*.test.mjs",
    "test:owner": "node --experimental-strip-types --test tests/owner-decision.test.ts tests/owner-decision-session.test.ts tests/owner-decision-client.test.ts tests/owner-decision-benchmark.test.ts tests/owner-decision-monthly.test.ts tests/owner-decision-e2e.test.ts",
    "test:owner:browser": "node --experimental-strip-types tests/owner-decision-smoke.mjs --run",
    "benchmark:owner": "node --experimental-strip-types scripts/owner-decision-benchmark.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-thai": "5.3.0",
    "playcanvas": "2.23.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
